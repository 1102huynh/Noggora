ANTHROPIC_API_KEY=            # optional — nếu trống, dùng manual script mode
PEXELS_API_KEY=                # optional — có cả 2 key thì mỗi video chia đều clip Pexels+Pixabay; trống hết thì dùng data/assets_local/
PIXABAY_API_KEY=               # optional — xem PEXELS_API_KEY ở trên
ELEVENLABS_API_KEY=            # optional — chỉ dùng nếu VOICE_PROVIDER=elevenlabs
