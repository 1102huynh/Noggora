# optional, trả phí — nếu trống, thử GROQ_API_KEY, rồi mới tới manual script mode
ANTHROPIC_API_KEY=
# optional, miễn phí — lấy tại console.groq.com — dùng để tự sinh script nếu không có ANTHROPIC_API_KEY
GROQ_API_KEY=
# optional — thiếu thì dùng Pixabay hoặc fallback local
PEXELS_API_KEY=
# optional — xem PEXELS_API_KEY ở trên
PIXABAY_API_KEY=
# optional — chỉ dùng nếu VOICE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
